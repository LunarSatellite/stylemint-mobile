<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same as values-v31: a night-mode device would otherwise pick
         values-night (night outranks the API level) and show the default
         icon splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/stylemint_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/stylemint_launch_background</item>
    </style>
</resources>
