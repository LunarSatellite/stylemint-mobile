<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for all API calls in release/profile builds. The Flutter tool
         only auto-injects INTERNET into the debug manifest, so release APKs
         have no network access without this. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Required by connectivity_plus (NetworkInfoConnectivityImpl.isConnected),
         used to gate every cart API call. Without it, checkConnectivity() can
         fail/throw and the cart repository short-circuits to "no internet"
         before ever calling the API. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Biometric / device-credential unlock (local_auth). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- QR scanner for cross-device web login (mobile_scanner); also the
         vendor Add Product wizard's "Capture Image" (image_picker). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- image_picker's gallery source (vendor Add Product "Upload Image").
         The Android 13+ Photo Picker doesn't need these, but some OEM
         builds (e.g. ColorOS) still gate the legacy media picker behind
         them on certain flows. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <application
        android:label="stylemint_mobile_frontend"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- singleTask: keep exactly ONE app instance. A deep link (e.g. the
             magic-link https intent) is delivered to the existing instance via
             onNewIntent — which app_links forwards to its stream — instead of
             launching a second instance in a new task.
             Do NOT add android:taskAffinity="" here; an empty affinity makes the
             deep-link intent target a different task and spawns a duplicate
             instance. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Deep links are handled exclusively by the app_links plugin
                 (see main.dart). Disable Flutter's built-in deep-linking so
                 GoRouter doesn't ALSO receive OS links and fail with
                 "route not found" on non-route URIs like
                 stylemint://social-connected. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Deep links: stylemint:// custom scheme -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="stylemint"/>
            </intent-filter>

            <!-- App Links: https://stylemint.voyageritnepal.com
                 Scoped to the app's own CONTENT paths only. We must NOT claim
                 the whole host, because the backend's OAuth callbacks live at
                 /v1/social/connect/*/callback on the same domain — if the app
                 intercepted those, the backend would never receive the auth
                 code and social connect would silently fail. Anything not
                 listed here (notably /v1/*) falls through to the browser, so
                 the server-side OAuth callback works.
                 Add a new <data android:pathPrefix="..."/> here when you ship a
                 new shareable universal link. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="stylemint.voyageritnepal.com"/>
                <data android:pathPrefix="/auth/magic"/>
                <data android:pathPrefix="/auth/oauth/callback"/>
                <data android:pathPrefix="/reels"/>
                <data android:pathPrefix="/product"/>
                <data android:pathPrefix="/order"/>
                <data android:pathPrefix="/creator"/>
                <data android:pathPrefix="/vendor"/>
                <data android:pathPrefix="/profile"/>
                <data android:pathPrefix="/drop"/>
                <data android:pathPrefix="/group-cart"/>
                <data android:pathPrefix="/groups"/>
                <data android:pathPrefix="/recommendations"/>
                <data android:pathPrefix="/reco"/>
                <data android:pathPrefix="/friend"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lets the OAuth/web flow open in an in-app Chrome Custom Tab
             (flutter_web_browser). Without these, Android 11+ package
             visibility hides browsers, so Custom Tabs can't be found and the
             launch falls back to the "Complete action using" app chooser. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService"/>
        </intent>
    </queries>
</manifest>
