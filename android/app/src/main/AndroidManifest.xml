<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- StyleMint Codes: vendors write shelf-code links to NFC tags. NFC isn't
         required, so phones without it can still install the app. -->
    <uses-permission android:name="android.permission.NFC"/>
    <uses-feature android:name="android.hardware.nfc" android:required="false"/>
    <!-- Shipping addresses are saved as a map point, not a typed street
         address: the customer taps "Use my current location" and we store the
         coordinates plus their own directions. Foreground use only — nothing
         is read in the background, and nothing is read unless they tap.
         COARSE is declared alongside FINE so a customer who grants only
         approximate location still gets a usable pin they can drag. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Location hardware isn't required: pasting a Maps link is a complete
         alternative, so phones without GPS can still install and check out. -->
    <uses-feature android:name="android.hardware.location" android:required="false"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
    <application
        android:label="StyleMint"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- main.dart routes every stylemint:// link itself (app_links), as iOS
                 does via FlutterDeepLinkingEnabled=false. Leaving Flutter's own deep
                 linking on also pushed links like stylemint://social-connected into
                 the router, which has no such page and showed "Page not found". -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- stylemint:// deep links — OAuth callback (auth/oauth/callback),
                 magic-link consumer, and in-app share targets (reel/product/
                 order/drop/group-cart/friend/reco). See routes/deep_links.dart. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="stylemint"/>
            </intent-filter>
            <!-- StyleMint share links for reels (https://stylemint.voyageritnepal.com/reels/{id})
                 open the reel in-app (main.dart routes them to /reels/:reelId).
                 Verified against the domain's /.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="stylemint.voyageritnepal.com"/>
                <data android:pathPrefix="/reels/"/>
            </intent-filter>
            <!-- StyleMint Codes (https://stylemint.voyageritnepal.com/c/{code}) from
                 printed QR codes and NFC tags open in-app (main.dart routes them to
                 /c/:code). Verified against the same assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="stylemint.voyageritnepal.com"/>
                <data android:pathPrefix="/c/"/>
            </intent-filter>
            <!-- Shared storefront links — brands
                 (https://stylemint.voyageritnepal.com/brands/{vendorAccountId})
                 and creators (.../creator-profile/{accountId}) — open in-app
                 (main.dart routes them to /brands/:vendorAccountId and
                 /creator-profile/:accountId). Same assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="stylemint.voyageritnepal.com"/>
                <data android:pathPrefix="/brands/"/>
                <data android:pathPrefix="/creator-profile/"/>
            </intent-filter>
        </activity>
        <!-- Maps SDK key for the drag-to-correct pin on the add-address
             screen. The value lives in res/values/google_maps_api.xml and is
             empty in source control — see that file. Declaring the key (even
             empty) is safer than omitting it: the SDK then fails
             authorisation and draws grey tiles instead of throwing when the
             map view is created. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_api_key" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Reel share sheet: which share targets can open (canLaunchUrl). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="viber"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="whatsapp"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="sms"/>
        </intent>
        <package android:name="com.facebook.katana"/>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
