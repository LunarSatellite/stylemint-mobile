<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:stylemint.voyageritnepal.com</string>
		<string>webcredentials:stylemint.voyageritnepal.com</string>
	</array>
	<!-- Native Sign in with Apple. Without this entitlement the OS sheet never
	     appears: getAppleIDCredential fails immediately, which looks exactly
	     like the button doing nothing. Requires "Sign In with Apple" to be
	     enabled on the App ID in the developer portal and the provisioning
	     profile to be regenerated after enabling it. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
