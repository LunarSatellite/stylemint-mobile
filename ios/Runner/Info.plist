<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>StyleMint converts speech to text only when you tap the microphone in Discover search.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>StyleMint uses the microphone only while you speak a Discover search.</string>
	<key>NSCameraUsageDescription</key>
	<string>Style Mint uses the camera to scan the QR code shown on the web login page.</string>
	<key>NFCReaderUsageDescription</key>
	<string>StyleMint uses NFC to write your shelf-code link to an NFC tag and check it.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>StyleMint opens your photo library so you can attach a photo — a KYC document, a return's condition evidence, a profile picture, or a screenshot to search with.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>StyleMint saves an image to your photo library only when you tap Save — for example a StyleMint code you want to keep or share.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>StyleMint uses Face ID to unlock your passkey so you can sign in without typing a password.</string>
	<!-- Declares that the app uses only exempt encryption: HTTPS/TLS, the
	     iOS Keychain via flutter_secure_storage, and platform passkeys. All
	     three are standard OS-provided cryptography and exempt under the
	     export rules. Without this key App Store Connect blocks every
	     TestFlight build on the export-compliance question until someone
	     answers it by hand. Change this to <true/> if the app ever ships its
	     own (non-OS) cryptography. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Stylemint Mobile Frontend</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>stylemint_mobile_frontend</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>app.stylemint.stylemintMobileFrontend</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>stylemint</string>
			</array>
		</dict>
	</array>
	<!-- Deep links are handled exclusively by the app_links plugin (see
	     main.dart). Disable Flutter's built-in deep-linking so GoRouter doesn't
	     also receive OS links and fail with "route not found" on non-route URIs
	     like stylemint://social-connected. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Shipping addresses are a map point plus the customer's own directions,
	     not a typed street address. Location is read only when they tap "Use
	     my current location" while adding or editing an address — never in the
	     background. Pasting a Maps link is a full alternative if they decline. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>StyleMint uses your location to pin where your order should be delivered, so you don't have to type out an address. We only check when you tap "Use my current location".</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>viber</string>
		<string>whatsapp</string>
		<string>sms</string>
	</array>
</dict>
</plist>
